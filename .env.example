# Copy to .env and replace with real local credentials. Never commit .env.
DATABASE_URL="mysql://restaurant_app:replace_me@127.0.0.1:3306/restaurant_platform"
APP_URL="http://localhost:3000"
APP_NAME="Foodie"
DEFAULT_CURRENCY="KES"
# Required for production admin sessions: use a long random secret (32+ characters).
SESSION_SECRET="replace_with_a_long_random_secret_at_least_32_characters"
# Temporary first-owner setup key (16+ characters). Remove after creating the first owner.
ADMIN_BOOTSTRAP_KEY="replace_with_a_long_one_time_setup_key"
