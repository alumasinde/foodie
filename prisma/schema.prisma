generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(160)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  tagline      String?  @db.VarChar(180)
  heroTitle    String?  @map("hero_title") @db.VarChar(180)
  heroSubtitle String?  @map("hero_subtitle") @db.Text
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  heroImageUrl String? @map("hero_image_url") @db.VarChar(500)
  primaryColor String  @default("#078C99") @map("primary_color") @db.Char(7)
  accentColor  String  @default("#FFB72B") @map("accent_color") @db.Char(7)
  phone        String? @db.VarChar(30)
  whatsappNumber String? @map("whatsapp_number") @db.VarChar(30)
  email        String? @db.VarChar(190)
  address      String? @db.VarChar(255)
  locationName String? @map("location_name") @db.VarChar(180)
  googleMapsUrl String? @map("google_maps_url") @db.VarChar(600)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  websiteUrl   String? @map("website_url") @db.VarChar(500)
  currency     String  @default("KES") @db.Char(3)
  timezone     String  @default("Africa/Nairobi") @db.VarChar(80)
  isPublished  Boolean @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  settings       RestaurantSetting[]
  openingHours   OpeningHour[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  diningAreas    DiningArea[]
  orders         CustomerOrder[]
  reservations   TableReservation[]
  roles          RestaurantRole[]
  memberships    RestaurantMembership[]

  @@map("restaurants")
}

model RestaurantSetting {
  id           String   @id @default(cuid()) @db.VarChar(30)
  restaurantId String   @map("restaurant_id") @db.VarChar(30)
  key          String   @db.VarChar(100)
  value        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("restaurant_settings")
}

model OpeningHour {
  id           String   @id @default(cuid()) @db.VarChar(30)
  restaurantId String   @map("restaurant_id") @db.VarChar(30)
  dayOfWeek    Int      @map("day_of_week") @db.UnsignedTinyInt
  opensAt      String?  @map("opens_at") @db.Char(5)
  closesAt     String?  @map("closes_at") @db.Char(5)
  isClosed     Boolean  @default(false) @map("is_closed")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("opening_hours")
}


model MenuCategory {
  id           String   @id @default(cuid()) @db.VarChar(30)
  restaurantId String   @map("restaurant_id") @db.VarChar(30)
  name         String   @db.VarChar(100)
  slug         String   @db.VarChar(110)
  description  String?  @db.VarChar(255)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, isActive, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(cuid()) @db.VarChar(30)
  restaurantId String   @map("restaurant_id") @db.VarChar(30)
  categoryId   String   @map("category_id") @db.VarChar(30)
  name         String   @db.VarChar(160)
  description  String?  @db.VarChar(500)
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?  @map("image_url") @db.VarChar(600)
  isAvailable  Boolean  @default(true) @map("is_available")
  isFeatured   Boolean  @default(false) @map("is_featured")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems CustomerOrderItem[]
  category   MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isAvailable, sortOrder])
  @@index([categoryId, isAvailable, sortOrder])
  @@map("menu_items")
}


model DiningArea {
  id           String   @id @default(cuid()) @db.VarChar(30)
  restaurantId String   @map("restaurant_id") @db.VarChar(30)
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(255)
  capacity     Int?     @db.UnsignedSmallInt
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations TableReservation[]
  @@unique([restaurantId, name])
  @@index([restaurantId, isActive, sortOrder])
  @@map("dining_areas")
}

model CustomerOrder {
  id             String   @id @default(cuid()) @db.VarChar(30)
  reference      String   @unique @db.VarChar(20)
  restaurantId   String   @map("restaurant_id") @db.VarChar(30)
  customerName   String   @map("customer_name") @db.VarChar(120)
  customerPhone  String   @map("customer_phone") @db.VarChar(30)
  orderType      String   @map("order_type") @db.VarChar(20)
  deliveryAddress String? @map("delivery_address") @db.VarChar(500)
  notes          String?  @db.VarChar(500)
  status         String   @default("received") @db.VarChar(30)
  subtotal       Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items          CustomerOrderItem[]
  @@index([restaurantId, status, createdAt])
  @@index([customerPhone, createdAt])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id          String   @id @default(cuid()) @db.VarChar(30)
  orderId     String   @map("order_id") @db.VarChar(30)
  menuItemId  String   @map("menu_item_id") @db.VarChar(30)
  itemName    String   @map("item_name") @db.VarChar(160)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity    Int      @db.UnsignedSmallInt
  lineTotal   Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  @@index([orderId])
  @@map("customer_order_items")
}

model TableReservation {
  id              String   @id @default(cuid()) @db.VarChar(30)
  reference       String   @unique @db.VarChar(20)
  restaurantId    String   @map("restaurant_id") @db.VarChar(30)
  diningAreaId    String?  @map("dining_area_id") @db.VarChar(30)
  customerName    String   @map("customer_name") @db.VarChar(120)
  customerPhone   String   @map("customer_phone") @db.VarChar(30)
  guestCount      Int      @map("guest_count") @db.UnsignedSmallInt
  reservationDate DateTime @map("reservation_date") @db.DateTime(0)
  notes           String?  @db.VarChar(500)
  status          String   @default("requested") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  diningArea      DiningArea? @relation(fields: [diningAreaId], references: [id], onDelete: SetNull)
  @@index([restaurantId, reservationDate, status])
  @@index([customerPhone, createdAt])
  @@map("table_reservations")
}


model User {
  id           String   @id @default(cuid()) @db.VarChar(30)
  email        String   @unique @db.VarChar(190)
  firstName    String   @map("first_name") @db.VarChar(70)
  lastName     String   @map("last_name") @db.VarChar(70)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  memberships  RestaurantMembership[]
  @@index([isActive])
  @@map("users")
}

model RestaurantRole {
  id           String   @id @default(cuid()) @db.VarChar(30)
  restaurantId String   @map("restaurant_id") @db.VarChar(30)
  name         String   @db.VarChar(80)
  key          String   @db.VarChar(60)
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  memberships  RestaurantMembership[]
  rolePermissions RolePermission[]
  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("roles")
}

model Permission {
  key         String   @id @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.VarChar(30)
  permissionKey String  @map("permission_key") @db.VarChar(80)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  role         RestaurantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model RestaurantMembership {
  id           String   @id @default(cuid()) @db.VarChar(30)
  restaurantId String   @map("restaurant_id") @db.VarChar(30)
  userId       String   @map("user_id") @db.VarChar(30)
  roleId       String   @map("role_id") @db.VarChar(30)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         RestaurantRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@unique([restaurantId, userId])
  @@index([userId, isActive])
  @@index([restaurantId, roleId])
  @@map("user_roles")
}
