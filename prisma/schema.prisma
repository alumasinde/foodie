generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(160)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  heroImageUrl String? @map("hero_image_url") @db.VarChar(500)
  primaryColor String  @default("#078C99") @map("primary_color") @db.Char(7)
  accentColor  String  @default("#FFB72B") @map("accent_color") @db.Char(7)
  phone        String? @db.VarChar(30)
  whatsappNumber String? @map("whatsapp_number") @db.VarChar(30)
  email        String? @db.VarChar(190)
  address      String? @db.VarChar(255)
  currency     String  @default("KES") @db.Char(3)
  timezone     String  @default("Africa/Nairobi") @db.VarChar(80)
  isPublished  Boolean @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  settings     RestaurantSetting[]
  openingHours OpeningHour[]

  @@map("restaurants")
}

model RestaurantSetting {
  id           String   @id @default(cuid()) @db.VarChar(30)
  restaurantId String   @map("restaurant_id") @db.VarChar(30)
  key          String   @db.VarChar(100)
  value        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("restaurant_settings")
}

model OpeningHour {
  id           String   @id @default(cuid()) @db.VarChar(30)
  restaurantId String   @map("restaurant_id") @db.VarChar(30)
  dayOfWeek    Int      @map("day_of_week") @db.UnsignedTinyInt
  opensAt      String?  @map("opens_at") @db.Char(5)
  closesAt     String?  @map("closes_at") @db.Char(5)
  isClosed     Boolean  @default(false) @map("is_closed")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("opening_hours")
}
